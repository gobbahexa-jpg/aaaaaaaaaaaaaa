# Environment configuration for DL Chat.
# App Check attestation protects backend requests.

# Death Legion OAuth (DL CHAT app)
# Set DEATH_LEGION_CLIENT_SECRET in Secrets for direct mobile token exchange,
# or set DEATH_LEGION_TOKEN_PROXY_URL to your confidential backend proxy endpoint.
DEATH_LEGION_CLIENT_SECRET=DEATH_LEGION_CLIENT_SECRET_DEFAULT_VALUE
DEATH_LEGION_TOKEN_PROXY_URL=DEATH_LEGION_TOKEN_PROXY_URL_DEFAULT_VALUE

# Optional trusted Firebase Cloud Functions backend URL (for Meta WhatsApp Cloud API & server actions).
# Never place WHATSAPP_ACCESS_TOKEN or WHATSAPP_APP_SECRET in this file!
DL_BACKEND_BASE_URL=DL_BACKEND_BASE_URL_DEFAULT_VALUE

# Text.lk Sri Lanka SMS Gateway & Contacts API v3 (https://app.text.lk/api/v3/)
# Set TEXT_LK_API_TOKEN in the Secrets panel for direct prototype access,
# or set it in Cloud Functions secrets for server-mediated dispatch.
TEXT_LK_API_TOKEN=TEXT_LK_API_TOKEN_DEFAULT_VALUE
TEXT_LK_SENDER_ID=TEXT_LK_SENDER_ID_DEFAULT_VALUE
TEXT_LK_DEFAULT_GROUP_ID=TEXT_LK_DEFAULT_GROUP_ID_DEFAULT_VALUE


