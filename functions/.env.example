# Confidential server-side secrets for Firebase Cloud Functions (NEVER bundle into Android APK).
# Copy to functions/.env for local emulator testing or configure via Firebase Secret Manager:
# firebase functions:secrets:set WHATSAPP_ACCESS_TOKEN
# firebase functions:secrets:set WHATSAPP_APP_SECRET
# firebase functions:secrets:set WHATSAPP_WEBHOOK_VERIFY_TOKEN

FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=ai-studio-android-dlchat-bddcbd1b-8921-4576-a2b4-2b965a255784

# Meta WhatsApp Business Platform Cloud API
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
WHATSAPP_SUPPORT_TEMPLATE_NAME=dl_chat_support_update
WHATSAPP_SECURITY_TEMPLATE_NAME=dl_chat_security_alert

# Text.lk Sri Lanka SMS Gateway & Contacts API v3
# firebase functions:secrets:set TEXT_LK_API_TOKEN
TEXT_LK_API_TOKEN=
