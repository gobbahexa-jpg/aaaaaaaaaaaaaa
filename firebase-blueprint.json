      "title": "UserProfile",
      "description": "Public discoverable profile for a DL Chat user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID matching document ID." },
        "username": { "type": "string", "description": "Lowercase unique handle (3-30 chars)." },
        "displayName": { "type": "string", "description": "User display name (1-60 chars)." },
        "bio": { "type": "string", "description": "Profile bio (0-240 chars)." },
        "statusMessage": { "type": "string", "description": "Short user status banner (0-120 chars)." },
        "avatarColor": { "type": "string", "description": "Hex accent color for avatar." },
        "photoDataBase64": { "type": "string", "description": "Optional compressed avatar image data." },
        "onlineStatus": { "type": "string", "enum": ["ONLINE", "AWAY", "DND", "OFFLINE"] },
