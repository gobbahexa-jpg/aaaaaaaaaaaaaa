      "required": ["userId", "username", "displayName", "bio", "avatarColor", "onlineStatus", "showLastSeen", "showOnline", "readReceipts", "discoverable", "suspended", "publicKeyFingerprint", "lastSeenAt", "createdAt", "updatedAt"]
