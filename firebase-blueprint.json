        "showOnline": { "type": "boolean" },
        "readReceipts": { "type": "boolean" },
        "discoverable": { "type": "boolean" },
        "suspended": { "type": "boolean" },
        "publicKeyFingerprint": { "type": "string", "description": "SHA-256 identity key fingerprint." },
        "publicKeyBase64": { "type": "string", "description": "X.509 EC secp256r1 public key for ECDH message encryption." },
        "keyVersion": { "type": "integer", "description": "Monotonic identity key rotation version." },
        "twoFactorEnabled": { "type": "boolean" },
        "profilePhotoVisibility": { "type": "string", "enum": ["EVERYONE", "CONTACTS", "NOBODY"] },
        "legionUserId": { "type": "string", "description": "Linked Death Legion OAuth user ID." },
        "legionUsername": { "type": "string", "description": "Linked Death Legion OAuth username." },
        "legionMemberNumber": { "type": "string", "description": "Death Legion membership number." },
        "legionVerificationStatus": { "type": "string", "description": "Death Legion verification state." },
